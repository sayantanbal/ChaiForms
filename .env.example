# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Neon Auth (Console → Branch → Auth → Configuration)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# API (Google Cloud Run locally / deployed)
PORT=8000
# NODE_ENV is set automatically (development via `pnpm dev`, production via `pnpm build`).
# Do not set NODE_ENV in .env — it breaks Next.js production builds.
BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Web (Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# Secrets (min 32 characters in production)
JWT_SECRET=replace-with-openssl-rand-base64-32
CSRF_SECRET=replace-with-openssl-rand-base64-32

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Optional legacy Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Demo login for judges (API only)
ENABLE_DEMO_LOGIN=false

# Email (Phase 5)
RESEND_API_KEY=
